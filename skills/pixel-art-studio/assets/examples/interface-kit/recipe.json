      "name": "RPG 界面套件",
      "screens": {
        "hud": {
          "title": "小镇 HUD",
          "description": "点击腰带格子或按 1-6 切换；悬停查看物品说明。"
        },
        "dialogue": {
          "title": "对话",
          "description": "点击显示完整台词，再选择回答。"
        },
        "inventory": {
          "title": "背包与装备",
          "description": "滚动背包，悬停武器栏查看说明。"
        },
        "battle": {
          "title": "战斗",
          "description": "选择指令或队员；选“攻击”会显示伤害数字。"
        },
        "shop": {
          "title": "商店",
          "description": "选择商品；购买会显示花费，离开会弹出确认。"
        },
        "select": {
          "title": "角色选择",
          "description": "用箭头浏览角色；五官保持极简，用表情气泡表达情绪。"
        }
      }
    }
